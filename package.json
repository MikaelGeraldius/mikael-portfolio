{
  "name": "mikael-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portfolio of Mikael Geraldius Gunawan, Informatics student focused on AI and web design.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "og": "node scripts/og-image.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:taste": "node .claude/skills/design-taste-frontend/scripts/lint.mjs src index.html",
    "inspect": "node .claude/skills/design-taste-frontend/scripts/inspect.mjs",
    "serve:dist": "node scripts/serve-dist.mjs 4791",
    "verify": "node scripts/verify.mjs http://127.0.0.1:4791/mikael-portfolio/ screenshots"
  },
  "dependencies": {
    "lenis": "^1.3.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
